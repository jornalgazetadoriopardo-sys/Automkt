# --- Claude (pesquisa de pautas e textos) ---
# Chave em https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# --- Supabase (opcional) ---
# Sem estas variáveis o app roda em "modo local": salva tudo em ./data
# Com elas, usa o banco e o Storage do Supabase (rode supabase/migrations/0001_inicial.sql antes).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Acesso ---
# Se preenchida, o app pede usuário e senha (usuário: qualquer um; senha: esta).
# Recomendado sempre que o app estiver na internet.
APP_SENHA=

# --- Navegador para gerar as artes ---
# Caminho do Chromium. Deixe vazio para usar o instalado pelo Playwright
# (npx playwright install chromium).
CHROMIUM_PATH=
